# ==============================================================================
# SIGET - Git Ignore Configuration (Python & Django)
# Consolidado al 19/11/2026
# ==============================================================================

# Entornos Virtuales y Dependencias Python
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class

# Node.js & Empaquetadores Legacy (Archivados)
node_modules/
pnpm-lock.yaml
pnpm-workspace.yaml
package-lock.json

# Base de datos local
db.sqlite3
*.sqlite3
*.db
*.db-shm
*.db-wal
*.backup*
*.bak

# Reportes y Planillas Generadas
reportes/*
!reportes/.gitkeep

# Archivos de Medios y Certificados Adjuntos
media/*
!media/.gitkeep
media/certificados/*
!media/certificados/.gitkeep

# Archivo Histórico Desktop y Resguardo
legacy_desktop_archive/
resguardo/*
!resguardo/.gitkeep

# Compilación y Logs
dist/
build/
*.log
.pytest_cache/

# Entornos y Secretos
.env
.env.*
*.local

# IDEs y Sistema Operativo
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
